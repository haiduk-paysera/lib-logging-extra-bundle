<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <imports>
        <import resource="services/*.xml"/>
    </imports>

    <services>
        <service id="paysera_logging_extra.trace_id_provider"
                 class="Paysera\LoggingExtraBundle\Service\LogTracing\TraceIdProvider">
            <argument type="service" id="request_stack"/>
            <argument>%paysera_logging_extra.trace_id_header%</argument>
        </service>

        <service id="paysera_logging_extra.processor.log_tracing"
                 class="Paysera\LoggingExtraBundle\Service\LogTracing\TraceIdProcessor">
            <argument type="service" id="paysera_logging_extra.trace_id_provider"/>
            <tag name="monolog.processor" handler="sentry"/>
        </service>
    </services>
</container>
